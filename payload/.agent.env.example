# Copy to .agent.env at the repo root and adjust. .agent.env is gitignored.
# Every value here overrides a default in scripts/agent/config.sh.

BASE_BRANCH=main
BRANCH_PREFIX=feature

# Your project's commands. Leave one empty to skip that check.
LINT_CMD="npm run lint --silent"
TYPECHECK_CMD="npx tsc --noEmit"
UNIT_CMD="npm run test:unit --silent"
INTEGRATION_CMD="npm run test:integration --silent"
E2E_CMD="npx playwright test --reporter=line"

# Formatter run on each file an agent edits (post-edit hook). Empty = off.
# Examples: "npx prettier --write", "black -q", "gofmt -w"
FORMAT_CMD=""

# How many failure lines run-checks.sh shows the agent per failing check.
FAIL_TAIL_LINES=40

# GitLab Duo's username(s), comma-separated. Check the author name on one Duo
# comment in your MRs. Leave empty to include every reviewer's open threads.
DUO_USERNAMES=""

# Stop the Duo fix loop after this many rounds (fetch-duo-review.sh --force to override).
MAX_REVIEW_ROUNDS=3

# Open new MRs as drafts.
MR_DRAFT=true

# --- Code review signals (scripts/agent/review-signals.sh) ---
# Regex (extended) for test file paths, and for migration file paths.
REVIEW_TEST_PATTERN='(\.|_)(test|spec)\.|/__tests__/|/tests?/|/e2e/'
REVIEW_MIGRATION_PATTERN='migration|migrate|schema\.(sql|prisma)'
# Changed files at or above this many lines get flagged as "large file".
REVIEW_LARGE_FILE_LINES=400

# --- Evidence screenshots (scripts/agent/capture-evidence.sh, uses Playwright) ---
# Where the app runs while capturing.
EVIDENCE_BASE_URL="http://localhost:3000"
# Command that starts the app. Leave empty if you start it yourself.
EVIDENCE_START_CMD="npm run dev"
# Logged-in session for pages behind a login. Create it once with:
#   npx playwright codegen --save-storage=.auth/evidence.json http://localhost:3000
# then log in with a TEST account and close the window. Keep .auth/ gitignored.
EVIDENCE_STORAGE_STATE=".auth/evidence.json"
EVIDENCE_VIEWPORT="1440x900"

# --- ClickUp (scripts/agent/clickup.sh) ---
# Your Workspace ID: the first number in any ClickUp URL, app.clickup.com/<this>/...
# Needed for custom task IDs (e.g. DEV-123) and for fetching linked ClickUp Docs.
CLICKUP_TEAM_ID=""
# Don't put CLICKUP_API_TOKEN here. Export it from your shell profile instead
# (see README, step 6), so it never sits in a file the agents read.

# ClickUp status the shipper moves the task to once the MR is open (exact name in your space).
CLICKUP_REVIEW_STATUS="in review"
# Max subtasks to pull descriptions for, and whether to download attachments.
CLICKUP_MAX_SUBTASKS=20
CLICKUP_DOWNLOAD_ATTACHMENTS=true
